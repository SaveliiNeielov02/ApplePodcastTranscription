<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Artist name</th>
            <th>Created At</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var session in Sessions)
        {
            <tr>
                <td>@(session.PodcastTitle ?? "Pending")</td>
                <td>@(session.PodcastArtist ?? "Pending")</td>
                <td>@DateTimeOffset.FromUnixTimeSeconds(session.SessionCreatedAtInUnixTimeSeconds).DateTime</td>
                <td>@session.TranscriptionStatus</td>
                <td>
                    @if (session.TranscriptionStatus == "Completed")
                    { 
                        <button class="btn btn-sm btn-outline-primary" 
                                @onclick="() => OnTranscriptViewClicked.InvokeAsync(session.Guid)">View transcript</button>   
                    }

                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public List<SessionDto> Sessions { get; set; } = [];

    [Parameter]
    public EventCallback<Guid> OnTranscriptViewClicked { get; set; }

}
