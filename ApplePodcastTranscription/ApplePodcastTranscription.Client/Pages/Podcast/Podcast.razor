@page "/podcast"
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div>
    <h3>Podcast link input</h3>
    <Input OnStartTranscript="HandleTranscriptionStart"/>

    <h3>Sessions table</h3>
    <Table Sessions="Sessions" OnTranscriptViewClicked="HandleTranscriptViewClicked"></Table>
</div>

@code {
    public List<SessionDtoHub> Sessions { get; set; } = [];
    private HubConnection? _hubConnection;
    private readonly HashSet<Guid> _subscribedSessions = [];
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/session-hub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid, int>("StateChanged", async (incomingGuid, progress) =>
        {
            var sessionToUpdate = Sessions.FirstOrDefault(s => s.Guid == incomingGuid);

            if (progress >= 100)
            {
                await UnsubscribeFromSessionAsync(incomingGuid);
            }

            if (sessionToUpdate != null)
            {
                sessionToUpdate.TranslationPercentage = progress;
                await InvokeAsync(StateHasChanged);
            }
        });

        await _hubConnection.StartAsync();

        await GetAllSessions();
        _ = StartPolling();
    }

    private async Task HandleTranscriptionStart(string url)
    {
        Console.WriteLine("Sending URL to server");
        try
        {
            var response = await Http.PostAsJsonAsync("api/session/initialize", new InitializeSession { PodcastUrl = url });
            response.EnsureSuccessStatusCode();
            await GetAllSessions();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error occurred while initializing session: {ex.Message}");
        }
    }
    private void HandleTranscriptViewClicked(Guid sessionGuid)
    {
        Navigation.NavigateTo($"/transcript/{sessionGuid}");
    }
    private async Task GetAllSessions()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<SessionDtoHub>>("api/transcript/sessions");
            if (response != null)
            {
                foreach (var incomingSession in response)
                {
                    var existingSession = Sessions.FirstOrDefault(s => s.Guid == incomingSession.Guid);
                    if (existingSession is { TranscriptionStatus: SessionStatus.InProgress })
                    {
                        incomingSession.TranslationPercentage = existingSession.TranslationPercentage;
                    }
                }

                Sessions = response;
                await SubscribeToActiveSessionsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching sessions: {ex.Message}");
        }
    }

    private async Task SubscribeToActiveSessionsAsync()
    {
        if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
            return;

        var activeSessions = Sessions.Where(s => s.TranscriptionStatus == SessionStatus.InProgress).ToList();

        foreach (var session in activeSessions)
        {
            if (!_subscribedSessions.Contains(session.Guid))
            {
                await _hubConnection.SendAsync("SubscribeToSession", session.Guid);
                _subscribedSessions.Add(session.Guid);
            }
        }
    }
    private async Task UnsubscribeFromSessionAsync(Guid sessionGuid)
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            if (_subscribedSessions.Contains(sessionGuid))
            {
                await _hubConnection.SendAsync("UnsubscribeFromSession", sessionGuid);
                _subscribedSessions.Remove(sessionGuid);
            }
        }
    }
    private async Task StartPolling()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await GetAllSessions();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        { }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync(); 
        _cts.Dispose();
        _timer?.Dispose();

        if (_hubConnection is not null)
        {
            foreach (var sessionGuid in _subscribedSessions.ToList())
            {
                await UnsubscribeFromSessionAsync(sessionGuid);
            }
            await _hubConnection.DisposeAsync();
        }
    }
}