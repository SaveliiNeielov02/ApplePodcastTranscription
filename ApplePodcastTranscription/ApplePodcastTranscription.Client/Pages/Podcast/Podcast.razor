@page "/podcast"
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div>
    <h3>Podcast link input</h3>
    <Input OnStartTranscript="HandleTranscriptionStart" />

    <h3>Sessions table</h3>
    <Table Sessions="Sessions" OnTranscriptViewClicked="HandleTranscriptViewClicked"></Table>
</div>

@code {
    public List<SessionDtoHub> Sessions { get; set; } = [];
    private HubConnection? _hubConnection;
    private readonly HashSet<Guid> _subscribedSessions = [];

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/session-hub"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid, int>("ProgressChanged", async (incomingGuid, progress) =>
        {
            var sessionToUpdate = Sessions.FirstOrDefault(s => s.Guid == incomingGuid);

            if (sessionToUpdate != null)
            {
                sessionToUpdate.TranslationPercentage = progress;
                await InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<Guid>("SessionChanged", async incomingGuid =>
        {
            await UpdateSession(incomingGuid);
        });

        await _hubConnection.StartAsync();

        await InitializeAllSessions();
    }

    private async Task InitializeAllSessions()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<SessionDtoHub>>("api/session/all");
            if (response != null)
            {
                Sessions = response;
                await SubscribeToSessionsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching sessions: {ex.Message}");
        }
    }
    private async Task UpdateSession(Guid sessionGuid)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<SessionDtoHub>($"api/session/{sessionGuid}");

            if (response != null)
            {
                bool needsUnsubscribe = false;

                await InvokeAsync(() =>
                {
                    var index = Sessions.FindIndex(s => s.Guid == response.Guid);

                    if (index >= 0)
                    {
                        if (Sessions[index].TranscriptionStatus == SessionStatus.InProgress)
                        {
                            response.TranslationPercentage = Sessions[index].TranslationPercentage;
                        }

                        Sessions[index] = response;
                    }

                    if (response.TranscriptionStatus is SessionStatus.Completed or SessionStatus.Failed)
                    {
                        needsUnsubscribe = true;
                    }

                    StateHasChanged();
                });

                if (needsUnsubscribe)
                {
                    await UnsubscribeFromSessionAsync(response.Guid);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching session {sessionGuid}: {ex.Message}");
        }
    }

    private async Task HandleTranscriptionStart(string url)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/initializer/init", new InitializeSession { PodcastUrl = url });
            response.EnsureSuccessStatusCode();

            var sessionGuid = await response.Content.ReadFromJsonAsync<Guid>();

            Sessions.Add(new SessionDtoHub { Guid = sessionGuid });
            await _hubConnection!.SendAsync("SubscribeToSession", sessionGuid);
            _subscribedSessions.Add(sessionGuid);

            StateHasChanged();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
    private void HandleTranscriptViewClicked(Guid sessionGuid)
    {
        Navigation.NavigateTo($"/transcript/{sessionGuid}");
    }

    private async Task SubscribeToSessionsAsync()
    {
        if (_hubConnection is null || _hubConnection.State != HubConnectionState.Connected)
            return;

        var sessionsToSubscribeOn = Sessions
                    .Where(s => s.TranscriptionStatus != SessionStatus.Completed
                                && s.TranscriptionStatus != SessionStatus.Failed);
        foreach (var session in sessionsToSubscribeOn)
        {
            if (!_subscribedSessions.Contains(session.Guid))
            {
                await _hubConnection.SendAsync("SubscribeToSession", session.Guid);
                _subscribedSessions.Add(session.Guid);
            }
        }
    }
    private async Task UnsubscribeFromSessionAsync(Guid sessionGuid)
    {
        if (_hubConnection is not null && _hubConnection.State == HubConnectionState.Connected)
        {
            if (_subscribedSessions.Contains(sessionGuid))
            {
                await _hubConnection.SendAsync("UnsubscribeFromSession", sessionGuid);
                _subscribedSessions.Remove(sessionGuid);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            foreach (var sessionGuid in _subscribedSessions.ToList())
            {
                await UnsubscribeFromSessionAsync(sessionGuid);
            }
            await _hubConnection.DisposeAsync();
        }
    }
}